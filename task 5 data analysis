        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import datetime\n",
        "import pytz\n",
        "import os\n",
        "\n",
        "# File path\n",
        "file_path = \"/content/apps_data.csv\"\n",
        "\n",
        "# Check if file exists\n",
        "if not os.path.exists(file_path):\n",
        "    print(f\"File '{file_path}' not found. Creating a sample dataset...\")\n",
        "\n",
        "    # Creating a sample dataset\n",
        "    data = {\n",
        "        \"Category\": [\"Games\", \"Games\", \"Productivity\", \"Games\", \"Social\"],\n",
        "        \"Rating\": [4.5, 3.8, 4.2, 4.1, 4.0],\n",
        "        \"Installs\": [\"100,000+\", \"50,000+\", \"500,000+\", \"1,000,000+\", \"10,000+\"],\n",
        "        \"Size\": [\"50M\", \"30M\", \"15M\", \"80M\", \"20M\"]\n",
        "    }\n",
        "\n",
        "    df = pd.DataFrame(data)\n",
        "    df.to_csv(file_path, index=False)\n",
        "    print(f\"Sample file '{file_path}' created successfully!\")\n",
        "\n",
        "# Convert current time to IST\n",
        "ist = pytz.timezone('Asia/Kolkata')\n",
        "current_time = datetime.datetime.now(ist).time()\n",
        "\n",
        "# Allowed time range (5 PM - 7 PM IST)\n",
        "start_time = datetime.time(17, 0)  # 5 PM\n",
        "end_time = datetime.time(19, 0)    # 7 PM\n",
        "\n",
        "# Show graph only if current time is within the range\n",
        "if start_time <= current_time <= end_time:\n",
        "    # Load dataset\n",
        "    df = pd.read_csv(file_path)\n",
        "\n",
        "    # Data Cleaning & Filtering\n",
        "    df['Installs'] = df['Installs'].astype(str).str.replace('[+,]', '', regex=True).astype(float)\n",
        "    df['Size'] = df['Size'].astype(str).str.replace('M', '', regex=True)\n",
        "\n",
        "    # Convert 'Varies with device' or missing size values to NaN and drop them\n",
        "    df['Size'] = pd.to_numeric(df['Size'], errors='coerce')\n",
        "    df.dropna(subset=['Size'], inplace=True)\n",
        "\n",
        "    # Apply filtering\n",
        "    filtered_df = df[\n",
        "        (df['Category'] == 'Games') &\n",
        "        (df['Rating'] > 3.5) &\n",
        "        (df['Installs'] > 50000)\n",
        "    ]\n",
        "\n",
        "    # Check if there's data to plot\n",
        "    if not filtered_df.empty:\n",
        "        # Create Bubble Chart\n",
        "        plt.figure(figsize=(10, 6))\n",
        "        plt.scatter(filtered_df['Size'], filtered_df['Rating'],\n",
        "                    s=filtered_df['Installs'] / 1000, alpha=0.5,\n",
        "                    c='blue', edgecolors=\"w\")\n",
        "\n",
        "        # Labels and title\n",
        "        plt.xlabel(\"App Size (MB)\")\n",
        "        plt.ylabel(\"Average Rating\")\n",
        "        plt.title(\"Games Apps: Size vs Rating (Bubble size = Installs)\")\n",
        "        plt.grid(True)\n",
        "\n",
        "        # Show the plot\n",
        "        plt.show()\n",
        "    else:\n",
        "        print(\"No data available after filtering.\")\n",
        "else:\n",
        "    print(\"Graph is not available outside 5 PM - 7 PM IST.\")\n"
